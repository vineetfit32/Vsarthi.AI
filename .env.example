# VSarthi.AI Environment Configuration
PORT=5000
NODE_ENV=development

# Authentication & Session Security
JWT_SECRET=vsarthi_production_jwt_secret_change_me_in_production
SESSION_EXPIRY_HOURS=24

# AI & LLM Clinical Engine (Google Gemini / AI4Bharat / OpenAI)
AI_API_KEY=
AI_MODEL=Gemini-3.8-Flash-Clinical

# Speech-to-Text & Text-to-Speech (Bhashini / Google Cloud Speech / AI4Bharat)
STT_API_KEY=
TTS_API_KEY=

# Document Intelligence & Optical Character Recognition (Google Cloud Vision / Tesseract / AI4Bharat OCR)
OCR_API_KEY=
OCR_ENGINE=hybrid_tesseract_vision

# National Health Authority — ABDM (Ayushman Bharat Digital Mission) Gateway
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_ENVIRONMENT=sandbox

# Hospital Information System (HIS / EMR) Integration Endpoint
HIS_INTEGRATION_URL=http://localhost:5000/api/his/export
HIS_API_KEY=

# Hospital SMS & Email Notifications (CDAC / Twilio / SendGrid)
SMS_API_KEY=
EMAIL_API_KEY=

# OPD Kiosk Configuration
KIOSK_TIMEOUT_SECONDS=60
