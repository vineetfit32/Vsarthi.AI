# VSarthi.AI Server Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=vsarthi_secure_jwt_secret_2026
ALLOWED_ORIGIN=http://localhost:5173

# AI & OCR Clinical Dialogue Engines
# Groq, OpenAI, or Gemini compatible endpoint for NLP intake & entity extraction
AI_API_KEY=
OCR_API_KEY=

# ABDM (Ayushman Bharat Digital Mission) Gateway
# When omitted, system defaults to ABDM Sandbox / Development Mock Adapter
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_ENVIRONMENT=sandbox

# Hospital Information System (HIS / EMR) Integration Bridge
# Configurable for HL7 FHIR R4, HL7 v2.5, or Indian Hospital OPD JSON
# When left as default or mock, the internal sandbox receiver handles dispatches
HIS_BASE_URL=http://localhost:5000/api/his/mock-receiver
HIS_API_KEY=
HIS_CLIENT_ID=
HIS_CLIENT_SECRET=
HIS_FORMAT=fhir
